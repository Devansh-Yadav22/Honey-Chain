# ─────────────────────────────────────────────
# Honey Chain — Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────

# ── General ──────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (PostgreSQL) ────────────────────
DATABASE_URL=postgresql://honeychain:honeychain@localhost:5432/honeychain

# ── AI Service ───────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── Hyperledger Fabric ───────────────────────
FABRIC_NETWORK=honeychain-network
FABRIC_CHANNEL=honeychain-channel
FABRIC_CHAINCODE=honeychain-cc
FABRIC_MSP_ID=Org1MSP
FABRIC_CERT_PATH=./blockchain/wallet/admin/cert.pem
FABRIC_KEY_PATH=./blockchain/wallet/admin/key.pem
FABRIC_CONNECTION_PROFILE=./blockchain/network/connection-org1.json

# ── Frontend ─────────────────────────────────
VITE_API_URL=http://localhost:5000/api
